package-as: DeathRollEnhancer
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
license-output: LICENSE.txt

ignore:
  - Media/DuelHeart.tga
  - Media/DuelTable.tga
  - Media/GoldTable.tga
  - Media/GoldTableGlints.tga
  - Media/GroupFeltTable.tga
  - Media/GroupSeatRim.tga
  - Media/GroupPortraitCorners.tga
  - Media/GroupTurnGlow.tga
  - Media/GroupBrassHand.tga
  - Media/GroupGoblinArm.tga
  - Media/GroupGoldCoin.tga
  - artwork
  - .claude
  - .vscode
  - versions
  - update-version.ps1
  - update-version.sh
  - PROJECT_CONTEXT.md
  - RELEASE_PROCESS.md
  - CurseForge_Description.md
  - .gitattributes
  - .codex
  - .qa
  - .github
  - AGENTS.md
  - tests
  - scripts
  - VERSION
  - .gitignore
